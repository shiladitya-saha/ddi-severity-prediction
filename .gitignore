# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
venv/
.venv/

# Data (too large for git — document download steps instead)
data/raw/*
!data/raw/.gitkeep
data/processed/*.pt
data/processed/*.csv
!data/processed/.gitkeep

# Model checkpoints (too large for git)
models/checkpoints/
*.pt
*.ckpt
*.pth
!features/full_features.pt

# Results that are large binary dumps (keep .json/.md summaries)
results/*.pt

# OS / editor
.DS_Store
.vscode/
.idea/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*credentials*
*secret*

# Keep raw and processed datasets out of Git, including nested files
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

!data/processed/.gitkeep
!data/processed/class_weights.json
!data/processed/severity_mapping.csv
!data/severity_overrides.csv
__pycache__/
.pytest_cache/
!data/processed/twosides_summary.json
"data/raw/pubchem_smiles.csv"

# Generated feature pipeline outputs
# full_features.pt and mechanism_edges.csv are M2's documented Day 2 deliverables
# (see features/README.md's file contract) -- they ARE committed, not ignored.
# Only the PubChem fetch cache and the failure log (debug artifact) stay out.
features/fingerprint_failures.log
!features/full_features.pt
!features/mechanism_edges.csv
